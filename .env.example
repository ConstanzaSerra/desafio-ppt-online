# Copiar este archivo como .env y completar con los valores reales.
# El .env NO se sube al repositorio.

# JSON completo de la cuenta de servicio de Firebase, en una sola línea
FIREBASE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# URL base de la API que consume el front
PARCEL_API_BASE_URL=http://localhost:3000
