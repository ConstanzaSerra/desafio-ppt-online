{
  "name": "desafio-ppt",
  "version": "1.0.0",
  "license": "MIT",
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "parcel": "2",
    "process": "^0.11.10"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "firebase": "^8.10.1",
    "firebase-admin": "^13.7.0",
    "lodash": "^4.17.23",
    "nanoid": "^5.1.7",
    "nodemon": "^3.1.14",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "dev:front": "parcel serve ./client/index.html --no-source-maps",
    "dev:api": "nodemon --watch ./server/index.ts --exec tsx ./server/index.ts",
    "build:front": "parcel build ./client/index.html",
    "build": "yarn build:front",
    "start": "tsx ./server/index.ts"
  }
}
